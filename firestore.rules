rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // All mutations go through validated server APIs using the Cloud Run service identity.
    // A browser (including an admin browser) cannot bypass audit/security or replay cached data.
    match /attendance_records/{recordId} {
      allow read: if true;
      allow write: if false;
    }
    match /students/{studentId} {
      allow read: if true;
      allow write: if false;
    }
    match /settings/{settingId} {
      allow read: if true;
      allow write: if false;
    }
    match /alerts/{alertId} {
      allow read: if request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.email == 'avasophianorgaard@gmail.com';
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
